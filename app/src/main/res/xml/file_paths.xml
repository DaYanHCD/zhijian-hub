<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 的路径声明。

  「安装包下载到 getExternalFilesDir(DIRECTORY_DOWNLOADS) 下的 Download/ 目录」
  —— 必须与 ApkStorage.downloadDir() 保持一致，否则拉起系统安装器时会报
  IllegalArgumentException: Failed to find configured root。
-->
<paths>
    <external-files-path
        name="apk_downloads"
        path="Download/" />
    <files-path
        name="apk_internal"
        path="apk_downloads/" />
</paths>
